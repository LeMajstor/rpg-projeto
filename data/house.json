  "dialogues": {
    "welcome": {
      "start": "0",
      "nodes": {
        "0": {
          "text": "Este é um NPC de teste. A conversa pausa a fila e as patrulhas do mapa.",
          "next": "1"
        },
        "1": {
          "text": "Use E, Enter ou o botão Avançar para ler as próximas falas. Ao encerrar, o mapa retoma.",
          "next": ""
        }
      }
    },
    "choices": {
      "start": "question",
      "nodes": {
        "question": {
          "text": "Qual teste você quer conhecer?",
          "choices": [
            {
              "text": "Encontros",
              "next": "encounters"
            },
            {
              "text": "Fila e colisões",
              "next": "formation"
            }
          ]
        },
        "encounters": {
          "text": "Os seis encontros ficam na mini dungeon, no mundo aberto. Saia da vila pelo portão. Todos usam os ritmos atuais de batalha; M2 impede fuga.",
          "next": "end"
        },
        "formation": {
          "text": "Os móveis da casa e os corredores do exterior e da dungeon permitem testar colisões e a fila.",
          "next": "end"
        },
        "end": {
          "text": "A resposta só muda esta conversa de teste. Não cria missão ou recompensa.",
          "next": ""
        }
      }
    },
    "collision": {
      "start": "0",
      "nodes": {
        "0": {
          "text": "Móveis e paredes da casa são sólidos. No exterior há árvores, pedras e corredores para testar colisões.",
          "next": "1"
        },
        "1": {
          "text": "Use F3 para ver volumes, rotas e o caminho seguido pela fila.",
          "next": ""
        }
      }
    },
    "sign": {
      "start": "0",
      "nodes": {
        "0": {
          "text": "VILA DE TESTES: há NPCs nesta casa e nas ruas. Use E para conversar, Enter para avançar e números para responder.",
          "next": "1"
        },
        "1": {
          "text": "O portão da vila leva ao mundo aberto. A mini dungeon fica fora da vila. Estados e recursos permanecem entre áreas.",
          "next": ""
        }
      }
    }
  },
