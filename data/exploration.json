  "dialogues": {
    "patrol": {
      "start": "0",
      "nodes": {
        "0": {
          "text": "Este NPC segue uma rota programada. Durante a conversa, ele para no ponto exato.",
          "next": "1"
        },
        "1": {
          "text": "O menu da equipe e o combate também pausam as patrulhas.",
          "next": "secret_hint"
        },
        "secret_hint": {
          "text": "À noite, há uma luz estranha junto da segunda casa, ao sul da praça. Durante o dia, a pedra parece comum.",
          "next": ""
        }
      }
    },
    "objects": {
      "start": "0",
      "nodes": {
        "0": {
          "text": "O portão da vila leva ao mundo aberto. A mini dungeon fica lá fora, seguindo o caminho até a entrada de pedra.",
          "next": "1"
        },
        "1": {
          "text": "O baú, a porta e a alavanca continuam na dungeon. Entrar na vila ou na casa não recupera HP e MP.",
          "next": ""
        }
      }
    },
    "clock_night": {
      "start": "0",
      "nodes": {
        "0": {
          "text": "É noite: as janelas das duas casas e o poste estão acesos. O relógio permanece pausado na vila; o mapa-múndi preserva e retoma esse horário.",
          "next": ""
        }
      }
    },
    "resident_night": {
      "start": "0",
      "nodes": {
        "0": {
          "text": "A luz estranha aparece na pedra ao lado desta casa durante a noite. Você pode examiná-la.",
          "next": ""
        }
      }
    },
    "resident_knows": {
      "start": "0",
      "nodes": {
        "0": {
          "text": "Você encontrou a inscrição escondida na pedra. A descoberta continua registrada, mesmo quando o dia volta.",
          "next": ""
        }
      }
    },
    "stone_day": {
      "start": "0",
      "nodes": {
        "0": {
          "text": "Uma pedra comum. À luz do dia, não é possível descobrir o seu segredo.",
          "next": ""
        }
      }
    },
    "stone_discover": {
      "start": "0",
      "nodes": {
        "0": {
          "text": "O Segredo da Casa: sob o brilho noturno, uma inscrição escondida fica visível. Descoberta registrada.",
          "next": ""
        }
      }
    },
    "stone_known": {
      "start": "0",
      "nodes": {
        "0": {
          "text": "Você já descobriu a inscrição escondida. A descoberta permanece registrada; não há nova recompensa.",
          "next": ""
        }
      }
    }
  },
