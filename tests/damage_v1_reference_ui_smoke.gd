extends "res://tests/damage_affliction_ui_smoke.gd"
func _run() -> void:
	root.size = Vector2i(1440,960)
	var path = "/private/tmp/rpg-v1-reference-ui-%d.json" % OS.get_process_id()
	var export_path = "/private/tmp/rpg-v1-reference-report-%d.json" % OS.get_process_id()
	var file = FileAccess.open(path,FileAccess.WRITE)
	file.store_string(FileAccess.get_file_as_string("res://artifacts/damage-lab-enemy02/presets-staged.json"))
	file.close()
	await new_screen(path)
	for entry in screen.preset_library.custom:
		if entry["actor"].get("character_id") == "ally_3": choose_preset("ally",entry["id"])
		if entry["name"] == "Monstro #1": choose_preset("enemy",entry["id"])
	action_id("magic_skill")
	expect(screen.action_picker.get_item_text(screen.action_picker.selected) == "Magia ofensiva básica" and screen.power_edit.value == 1.5 and screen.mp_cost_edit.value == 7,"Rótulo e parâmetros adotados na V1")
	expect(screen.evasion_allowed.disabled and not screen.evasion_allowed.button_pressed and screen.critical_allowed.disabled and not screen.critical_allowed.button_pressed,"Dano mágico não permite EVA/crítico")
	screen.profile_edits["target"]["evasion_base"].value = 100
	screen.evasion_allowed.button_pressed = true
	key(KEY_F9)
	var result: Dictionary = screen.last_result.duplicate(true)
	expect(result["count"] == 1000 and result["evasion_count"] == 0 and result["critical_count"] == 0 and result["minimum"] >= 32 and result["maximum"] <= 39,"Lote mantém regra contra EVA100")
	expect(result["samples"][0]["mp_after"] == 17 and result["snapshot"]["action"]["evasion_allowed"] == false,"Custo7 e snapshot normalizado")
	expect(result["snapshot"]["ruleset"]["decision"] == "D124","Condições identificam referência V1")
	screen.action_picker.grab_focus()
	var scroll = screen.action_picker.get_parent()
	while not scroll is ScrollContainer: scroll = scroll.get_parent()
	scroll.ensure_control_visible(screen.evasion_allowed)
	await process_frame
	await capture("magia-ofensiva-v1")
	var rng: Dictionary = screen.model.rng_state.duplicate()
	screen._request_export()
	screen._save_export(export_path)
	var report: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(export_path))
	expect(report["conditions"]["action"]["name"] == "Magia ofensiva básica" and report["formula"]["status"] == "approved_initial" and report["formula"]["action_reference_status"] == "v1_reference","JSON distingue a referência aprovada")
	expect(screen.model.rng_state == rng and screen.last_result == result,"Exportação preserva sorteios/histórico")
	action_id("poison")
	expect(not screen.evasion_allowed.disabled and screen.evasion_allowed.button_pressed,"Aflições preservam regra de EVA por ação")
	key(KEY_F7)
	expect(screen.last_result["evasion_count"] == 10 and screen.last_result["samples"][0]["mp_after"] == 20,"EVA100 evita aflição, custo4 permanece")
	action_id("physical_skill")
	expect("experimento" in screen.action_picker.get_item_text(screen.action_picker.selected) and screen.model.action["reference_status"] == "experimental","Outra técnica genérica é explicitamente experimento")
	choose(screen.history_picker,0)
	expect(screen.last_result == result and screen.last_result["snapshot"]["action"]["name"] == "Magia ofensiva básica","Troca de ação não altera resultado antigo")
	screen.queue_free()
	await process_frame
	DirAccess.remove_absolute(path)
	DirAccess.remove_absolute(export_path)
	print("REFERÊNCIA V1/UI: %d verificações, %d falhas" % [checks,failures])
	quit(0 if failures==0 else 1)
