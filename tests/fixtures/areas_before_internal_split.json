    "dialogues": {
      "welcome": {
        "start": "0",
        "nodes": {
          "0": {
            "text": "Este é um NPC de teste. A conversa pausa a fila e as patrulhas do mapa.",
            "next": "1"
          },
          "1": {
            "text": "Use E, Enter ou o botão Avançar para ler as próximas falas. Ao encerrar, o mapa retoma.",
            "next": ""
          }
        }
      },
      "choices": {
        "start": "question",
        "nodes": {
          "question": {
            "text": "Qual teste você quer conhecer?",
            "choices": [
              {
                "text": "Encontros",
                "next": "encounters"
              },
              {
                "text": "Fila e colisões",
                "next": "formation"
              }
            ]
          },
          "encounters": {
            "text": "Os seis monstros visíveis usam presets existentes. M2 usa B, que impede fuga.",
            "next": "end"
          },
          "formation": {
            "text": "Contorne árvores e pedras. Ao sul, os corredores estreitos testam o caminho da fila.",
            "next": "end"
          },
          "end": {
            "text": "A resposta só muda esta conversa de teste. Não cria missão ou recompensa.",
            "next": ""
          }
        }
      },
      "collision": {
        "start": "0",
        "nodes": {
          "0": {
            "text": "Paredes, troncos e pedras são sólidos. Os integrantes do grupo não colidem entre si.",
            "next": "1"
          },
          "1": {
            "text": "Use F3 para ver volumes, rotas e o caminho seguido pela fila.",
            "next": ""
          }
        }
      },
      "patrol": {
        "start": "0",
        "nodes": {
          "0": {
            "text": "Este NPC segue uma rota programada. Durante a conversa, ele para no ponto exato.",
            "next": "1"
          },
          "1": {
            "text": "O menu da equipe e o combate também pausam as patrulhas.",
            "next": ""
          }
        }
      },
      "objects": {
        "start": "0",
        "nodes": {
          "0": {
            "text": "Baú, placa, porta e alavanca ficam na região de objetos.",
            "next": "1"
          },
          "1": {
            "text": "São apenas efeitos de teste. O baú não adiciona itens e a porta não leva a outro mapa.",
            "next": ""
          }
        }
      },
      "chest": {
        "start": "0",
        "nodes": {
          "0": {
            "text": "Baú aberto. O sprite mudou e o estado ficará registrado até Reiniciar teste.",
            "next": "1"
          },
          "1": {
            "text": "Nenhum item foi adicionado: não há inventário novo nesta etapa.",
            "next": ""
          }
        }
      },
      "chest_repeat": {
        "start": "0",
        "nodes": {
          "0": {
            "text": "O baú já está aberto nesta sessão. Não há recompensa repetida.",
            "next": ""
          }
        }
      },
      "sign": {
        "start": "0",
        "nodes": {
          "0": {
            "text": "PLACA DE TESTE: E interage com o elemento mais próximo que esteja ao alcance e sem parede no caminho.",
            "next": "1"
          },
          "1": {
            "text": "A alavanca alterna a porta. A porta também pode ser aberta ou fechada diretamente.",
            "next": ""
          }
        }
      },
      "door_open": {
        "start": "0",
        "nodes": {
          "0": {
            "text": "Porta aberta. A passagem está livre; nenhum mapa foi carregado.",
            "next": ""
          }
        }
      },
      "door_closed": {
        "start": "0",
        "nodes": {
